{
    "overrides": [
        {
            "files": ["*.json"],
            "options": {
                "tabWidth": 4
            }
        }
    ],
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 80,
    "plugins": ["prettier-plugin-tailwindcss"]
}
